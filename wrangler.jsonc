// Worker "dautucungvu": phục vụ site tĩnh html/ + API /api/* (GAS.md mục 0, VIII, X).
// Repo nối với Worker qua Cloudflare Workers Builds (deploy command `npx wrangler deploy`,
// build command để TRỐNG): html/ đã được GitHub Actions build sẵn và commit vào repo.
// Khóa bí mật KHÔNG để ở đây (repo public) — đặt bằng `npx wrangler secret put <TÊN>`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dautucungvu",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./html",
    "binding": "ASSETS",
    // Giữ MẶC ĐỊNH "auto-trailing-slash" để /slug/ tự phục vụ slug/index.html (GAS.md 0.1)
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Bắt buộc: không có dòng này thì request /api/* không khớp file tĩnh có thể bị trả trang 404
    // thay vì chạy Worker (not_found_handling xử lý trước).
    "run_worker_first": ["/api/*"]
  },

  "routes": [{ "pattern": "dautucungvu.com", "custom_domain": true }],
  // Chỉ phục vụ qua domain thật, không mở *.workers.dev / preview URL
  "workers_dev": false,
  "preview_urls": false,

  // D1 tạo 20/10/2026 (region APAC)
  "d1_databases": [
    { "binding": "DB", "database_name": "dautucungvu", "database_id": "7ed75e1e-7173-48c9-99b4-2af6cfac1c55", "migrations_dir": "worker/migrations" }
  ],
  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "dautucungvu-videos" }],
  // Email giao dịch (Cloudflare Email Service — domain đã bật Email Sending, GAS.md VI.5)
  "send_email": [{ "name": "EMAIL" }],
  // 08:00 giờ VN: hết hạn đơn chờ + email nhắc gia hạn (worker/src/cron.js)
  "triggers": { "crons": ["0 1 * * *"] },

  "vars": {
    "SITE_URL": "https://dautucungvu.com",
    "R2_BUCKET": "dautucungvu-videos",
    // Account ID không phải bí mật (dùng ký presigned URL R2)
    "R2_ACCOUNT_ID": "975f2208a74d9e0b5048659725df1911",
    // "1" chỉ trong giai đoạn thử rủi ro GĐ1; về "0" trước khi mở bán
    "ENABLE_TEST_ROUTES": "1",
    "MAIL_FROM": "thongbao@dautucungvu.com",
    "MAIL_REPLY_TO": "lienhe@dautucungvu.com",
    "ORDER_NOTIFY_EMAIL": "truongvutienphuoc@gmail.com",
    "CMS_URL": "https://dautucungvu.com/admin/",
    // Khóa CÔNG KHAI của Turnstile (secret là TURNSTILE_SECRET, đặt bằng wrangler secret)
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFdoZBmQ_HkuKLVd"
  },

  "observability": { "enabled": true }
}
